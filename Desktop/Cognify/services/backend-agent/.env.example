# Backend AI Agent Service Environment Configuration
# Copy this file to .env and update the values according to your environment

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3002
HOST=localhost
API_BASE_URL=http://localhost:3002

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
LOG_DATE_PATTERN=YYYY-MM-DD

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=backend-agent:
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_RETRY_DELAY_ON_FAILURE=100
REDIS_MAX_RETRY_DELAY=2000
REDIS_MAX_RETRIES=3

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
CACHE_ENABLED=true
CACHE_TYPE=redis
CACHE_TTL=3600
CACHE_MAX_SIZE=1000
CACHE_CHECK_PERIOD=600

# =============================================================================
# OPENAI CONFIGURATION
# =============================================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.1
OPENAI_TIMEOUT=60000
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_DELAY=1000

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=24h
JWT_ISSUER=cognify-backend-agent
JWT_AUDIENCE=cognify-users
API_KEY_HEADER=X-API-Key
API_KEYS=dev-key-123,admin-key-456

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MESSAGE=Too many requests, please try again later
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false
RATE_LIMIT_SKIP_FAILED_REQUESTS=false

# AI-specific rate limiting
AI_RATE_LIMIT_WINDOW_MS=3600000
AI_RATE_LIMIT_MAX_REQUESTS=50
AI_RATE_LIMIT_MESSAGE=AI request limit exceeded, please try again later

# =============================================================================
# TASK CONFIGURATION
# =============================================================================
TASK_QUEUE_CONCURRENCY=5
TASK_TIMEOUT=300000
TASK_RETRY_ATTEMPTS=3
TASK_RETRY_DELAY=5000
TASK_CLEANUP_INTERVAL=3600000
TASK_MAX_HISTORY=1000

# =============================================================================
# BACKEND CODE GENERATION CONFIGURATION
# =============================================================================
BACKEND_SUPPORTED_FRAMEWORKS=express,fastify,koa,nestjs
BACKEND_SUPPORTED_DATABASES=mongodb,postgresql,mysql,redis
BACKEND_DEFAULT_FRAMEWORK=express
BACKEND_DEFAULT_DATABASE=mongodb
BACKEND_CODE_STYLE=airbnb
BACKEND_INCLUDE_TESTS=true
BACKEND_INCLUDE_DOCS=true
BACKEND_INCLUDE_VALIDATION=true
BACKEND_INCLUDE_AUTH=true
BACKEND_INCLUDE_LOGGING=true
BACKEND_INCLUDE_MONITORING=true

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_MAX_FILES=10
UPLOAD_ALLOWED_TYPES=.js,.json,.md,.txt,.yaml,.yml
UPLOAD_TEMP_DIR=./temp
UPLOAD_CLEANUP_INTERVAL=3600000

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
CORS_CREDENTIALS=true
HELMET_ENABLED=true
CSP_ENABLED=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# =============================================================================
# TELEMETRY CONFIGURATION
# =============================================================================
TELEMETRY_ENABLED=true
TELEMETRY_SERVICE_NAME=backend-ai-agent
TELEMETRY_SERVICE_VERSION=1.0.0

# OpenTelemetry configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_RESOURCE_ATTRIBUTES=service.name=backend-ai-agent,service.version=1.0.0

# Jaeger configuration
JAEGER_ENABLED=true
JAEGER_ENDPOINT=http://localhost:14268/api/traces
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6832

# Prometheus configuration
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_ENDPOINT=/metrics
PROMETHEUS_PREFIX=backend_agent_

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3

# =============================================================================
# ORCHESTRATOR INTEGRATION
# =============================================================================
ORCHESTRATOR_URL=http://localhost:3000
ORCHESTRATOR_API_KEY=orchestrator-api-key
ORCHESTRATOR_TIMEOUT=30000
ORCHESTRATOR_RETRY_ATTEMPTS=3
ORCHESTRATOR_RETRY_DELAY=2000
ORCHESTRATOR_HEALTH_CHECK_INTERVAL=60000

# =============================================================================
# SERVICE DISCOVERY
# =============================================================================
SERVICE_DISCOVERY_ENABLED=false
SERVICE_DISCOVERY_TYPE=consul
SERVICE_DISCOVERY_HOST=localhost
SERVICE_DISCOVERY_PORT=8500
SERVICE_REGISTRY_TTL=30
SERVICE_REGISTRY_INTERVAL=15

# =============================================================================
# DATABASE CONFIGURATION (if needed)
# =============================================================================
DATABASE_URL=mongodb://localhost:27017/cognify-backend-agent
DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECTION_TIMEOUT=30000
DATABASE_SOCKET_TIMEOUT=30000
DATABASE_RETRY_WRITES=true
DATABASE_W=majority

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================
DEBUG=backend-agent:*
NODE_OPTIONS=--max-old-space-size=4096
UV_THREADPOOL_SIZE=128

# Testing configuration
TEST_TIMEOUT=30000
TEST_REDIS_DB=15
TEST_OPENAI_API_KEY=test-key
TEST_JWT_SECRET=test-jwt-secret

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
MAX_REQUEST_SIZE=50mb
KEEP_ALIVE_TIMEOUT=65000
HEADERS_TIMEOUT=66000
MAX_HEADER_SIZE=16384
CLUSTER_WORKERS=0

# =============================================================================
# MONITORING & ALERTING
# =============================================================================
MONITORING_ENABLED=true
ALERT_WEBHOOK_URL=
ALERT_SLACK_WEBHOOK=
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_USER=
ALERT_EMAIL_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_CODE_GENERATION=true
FEATURE_DATABASE_SCHEMA=true
FEATURE_AUTHENTICATION=true
FEATURE_MIDDLEWARE=true
FEATURE_TESTING=true
FEATURE_OPTIMIZATION=true
FEATURE_DOCUMENTATION=true
FEATURE_DEPLOYMENT=true
FEATURE_REAL_TIME_COLLABORATION=false
FEATURE_ADVANCED_ANALYTICS=false