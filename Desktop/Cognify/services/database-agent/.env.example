# Database AI Agent Environment Configuration
# Copy this file to .env and update the values for your environment

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3003
HOST=0.0.0.0
BODY_LIMIT=10mb
TRUST_PROXY=false

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs/database-agent.log
LOG_FILE_MAX_SIZE=20m
LOG_FILE_MAX_FILES=14d
LOG_CONSOLE_ENABLED=true

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2
REDIS_KEY_PREFIX=database-agent:
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_RETRY_ATTEMPTS=3
REDIS_RETRY_DELAY=1000

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=3600
CACHE_MAX_KEYS=10000
CACHE_SCHEMA_TTL=7200
CACHE_QUERY_TTL=1800
CACHE_MIGRATION_TTL=3600
CACHE_PERFORMANCE_TTL=900

# =============================================================================
# OPENAI API CONFIGURATION
# =============================================================================
OPENAI_ENABLED=true
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.1
OPENAI_TIMEOUT=30000
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_DELAY=1000

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_ISSUER=cognify-database-agent
JWT_AUDIENCE=cognify-users

# API Key Authentication
API_KEY_HEADER=X-API-Key
API_KEYS=dev-key-123,test-key-456,prod-key-789

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MESSAGE=Too many requests, please try again later
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false
RATE_LIMIT_SKIP_FAILED_REQUESTS=false

# Burst Protection
BURST_LIMIT_ENABLED=true
BURST_LIMIT_WINDOW_MS=60000
BURST_LIMIT_MAX_REQUESTS=20

# AI-Specific Rate Limiting
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_WINDOW_MS=3600000
AI_RATE_LIMIT_MAX_REQUESTS=50
AI_RATE_LIMIT_COST_PER_REQUEST=1

# Schema Generation Rate Limiting
SCHEMA_RATE_LIMIT_WINDOW_MS=3600000
SCHEMA_RATE_LIMIT_MAX_REQUESTS=20

# Query Optimization Rate Limiting
QUERY_RATE_LIMIT_WINDOW_MS=3600000
QUERY_RATE_LIMIT_MAX_REQUESTS=30

# Migration Generation Rate Limiting
MIGRATION_RATE_LIMIT_WINDOW_MS=3600000
MIGRATION_RATE_LIMIT_MAX_REQUESTS=15

# Performance Analysis Rate Limiting
PERFORMANCE_RATE_LIMIT_WINDOW_MS=3600000
PERFORMANCE_RATE_LIMIT_MAX_REQUESTS=25

# =============================================================================
# TASK MANAGEMENT CONFIGURATION
# =============================================================================
TASK_QUEUE_ENABLED=true
TASK_MAX_CONCURRENT=5
TASK_DEFAULT_TIMEOUT=300000
TASK_RETRY_ATTEMPTS=3
TASK_RETRY_DELAY=5000
TASK_CLEANUP_INTERVAL=3600000
TASK_MAX_AGE=86400000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_SUPPORTED_TYPES=mongodb,mysql,postgresql,sqlite
DATABASE_DEFAULT_TIMEOUT=30000
DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECTION_TIMEOUT=10000

# Schema Generation
SCHEMA_MAX_TABLES=50
SCHEMA_MAX_FIELDS_PER_TABLE=100
SCHEMA_INCLUDE_INDEXES=true
SCHEMA_INCLUDE_CONSTRAINTS=true
SCHEMA_CODE_STYLE=camelCase

# Query Optimization
QUERY_MAX_LENGTH=10000
QUERY_ANALYSIS_DEPTH=deep
QUERY_INCLUDE_EXPLAIN_PLAN=true
QUERY_SUGGEST_INDEXES=true

# Migration Generation
MIGRATION_INCLUDE_ROLLBACK=true
MIGRATION_BATCH_SIZE=1000
MIGRATION_SAFE_MODE=true
MIGRATION_BACKUP_RECOMMENDATION=true

# Performance Analysis
PERFORMANCE_METRICS_ENABLED=true
PERFORMANCE_SLOW_QUERY_THRESHOLD=1000
PERFORMANCE_INDEX_ANALYSIS=true
PERFORMANCE_MEMORY_ANALYSIS=true

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
UPLOAD_ENABLED=true
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_MAX_FILES=5
UPLOAD_ALLOWED_TYPES=.sql,.json,.js,.ts,.md
UPLOAD_DESTINATION=tmp/uploads
UPLOAD_PRESERVE_PATH=false

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
SECURITY_HELMET_ENABLED=true
SECURITY_CORS_ENABLED=true
SECURITY_CORS_ORIGIN=http://localhost:3000,http://localhost:3001
SECURITY_CORS_CREDENTIALS=true

# Content Security Policy
CSP_ENABLED=true
CSP_REPORT_ONLY=false
CSP_REPORT_URI=/api/security/csp-report

# Input Validation
VALIDATION_STRICT_MODE=true
VALIDATION_SANITIZE_HTML=true
VALIDATION_MAX_STRING_LENGTH=10000
VALIDATION_MAX_ARRAY_LENGTH=1000

# =============================================================================
# TELEMETRY CONFIGURATION
# =============================================================================
TELEMETRY_ENABLED=true
TELEMETRY_SERVICE_NAME=database-agent
TELEMETRY_SERVICE_VERSION=1.0.0

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_RESOURCE_ATTRIBUTES=service.name=database-agent,service.version=1.0.0

# Jaeger Tracing
JAEGER_ENABLED=true
JAEGER_ENDPOINT=http://localhost:14268/api/traces
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6832
JAEGER_SAMPLER_TYPE=const
JAEGER_SAMPLER_PARAM=1

# Prometheus Metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9464
PROMETHEUS_ENDPOINT=/metrics
PROMETHEUS_PREFIX=database_agent_

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3

# Dependency Health Checks
HEALTH_CHECK_REDIS=true
HEALTH_CHECK_OPENAI=true
HEALTH_CHECK_EXTERNAL_SERVICES=false

# =============================================================================
# ORCHESTRATOR INTEGRATION
# =============================================================================
ORCHESTRATOR_ENABLED=true
ORCHESTRATOR_URL=http://localhost:3001
ORCHESTRATOR_API_KEY=orchestrator-api-key
ORCHESTRATOR_TIMEOUT=10000
ORCHESTRATOR_RETRY_ATTEMPTS=3
ORCHESTRATOR_HEARTBEAT_INTERVAL=30000

# =============================================================================
# SERVICE DISCOVERY
# =============================================================================
SERVICE_DISCOVERY_ENABLED=true
SERVICE_DISCOVERY_TYPE=consul
SERVICE_DISCOVERY_HOST=localhost
SERVICE_DISCOVERY_PORT=8500
SERVICE_DISCOVERY_SERVICE_NAME=database-agent
SERVICE_DISCOVERY_SERVICE_ID=database-agent-1
SERVICE_DISCOVERY_HEALTH_CHECK_URL=http://localhost:3003/api/health
SERVICE_DISCOVERY_TAGS=ai,database,microservice

# =============================================================================
# DATABASE CONNECTION (for metadata storage)
# =============================================================================
DATABASE_URL=mongodb://localhost:27017/cognify_database_agent
DATABASE_OPTIONS={"useNewUrlParser":true,"useUnifiedTopology":true}

# =============================================================================
# DEVELOPMENT/TESTING CONFIGURATION
# =============================================================================
DEV_MODE=true
DEV_MOCK_AI_RESPONSES=false
DEV_ENABLE_PLAYGROUND=true
DEV_CORS_ORIGIN=*

# Testing
TEST_DATABASE_URL=mongodb://localhost:27017/cognify_database_agent_test
TEST_REDIS_DB=15
TEST_TIMEOUT=30000

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
PERF_CLUSTER_MODE=false
PERF_WORKER_PROCESSES=auto
PERF_MAX_MEMORY_USAGE=512
PERF_GC_INTERVAL=300000

# Connection Pooling
PERF_REDIS_POOL_SIZE=10
PERF_HTTP_KEEP_ALIVE=true
PERF_HTTP_TIMEOUT=30000

# =============================================================================
# MONITORING AND ALERTING
# =============================================================================
MONITORING_ENABLED=true
MONITORING_WEBHOOK_URL=
MONITORING_ALERT_THRESHOLD_ERROR_RATE=0.05
MONITORING_ALERT_THRESHOLD_RESPONSE_TIME=5000
MONITORING_ALERT_THRESHOLD_MEMORY_USAGE=0.8

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_SCHEMA_GENERATION=true
FEATURE_QUERY_OPTIMIZATION=true
FEATURE_MIGRATION_GENERATION=true
FEATURE_PERFORMANCE_ANALYSIS=true
FEATURE_REAL_TIME_MONITORING=true
FEATURE_ADVANCED_CACHING=true
FEATURE_BATCH_PROCESSING=false
FEATURE_WEBHOOK_NOTIFICATIONS=false