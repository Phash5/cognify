# DevOps AI Agent Environment Configuration
# Copy this file to .env and update the values according to your environment

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3003
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080
MAX_REQUEST_SIZE=10mb
REQUEST_TIMEOUT=300000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
LOG_DATE_PATTERN=YYYY-MM-DD

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=3
REDIS_KEY_PREFIX=devops_agent:
REDIS_CONNECTION_TIMEOUT=5000
REDIS_COMMAND_TIMEOUT=3000
REDIS_RETRY_ATTEMPTS=3
REDIS_RETRY_DELAY=1000

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
CACHE_DEFAULT_TTL=3600
CACHE_MAX_KEYS=10000
CACHE_AI_RESPONSE_TTL=7200
CACHE_TASK_RESULT_TTL=86400
CACHE_DEPLOYMENT_TTL=3600
CACHE_INFRASTRUCTURE_TTL=7200
CACHE_MONITORING_TTL=3600
CACHE_CONFIGURATION_TTL=1800

# =============================================================================
# OPENAI API CONFIGURATION
# =============================================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.1
OPENAI_TOP_P=1
OPENAI_FREQUENCY_PENALTY=0
OPENAI_PRESENCE_PENALTY=0
OPENAI_TIMEOUT=60000
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_DELAY=1000

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters
JWT_EXPIRES_IN=24h
JWT_ISSUER=devops-ai-agent
JWT_AUDIENCE=cognify-ai

# API Key Authentication
API_KEYS=dev_key_123,prod_key_456,admin_key_789
API_KEY_HEADER=X-API-Key

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================

# General Rate Limiting
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false
RATE_LIMIT_SKIP_FAILED_REQUESTS=false

# AI-Specific Rate Limiting
RATE_LIMIT_AI_MAX_REQUESTS=100
RATE_LIMIT_AI_WINDOW_MS=3600000
RATE_LIMIT_AI_SKIP_SUCCESSFUL_REQUESTS=false

# DevOps-Specific Rate Limiting
RATE_LIMIT_DEVOPS_DEPLOYMENT_MAX_REQUESTS=50
RATE_LIMIT_DEVOPS_DEPLOYMENT_WINDOW_MS=3600000

RATE_LIMIT_DEVOPS_INFRASTRUCTURE_MAX_REQUESTS=30
RATE_LIMIT_DEVOPS_INFRASTRUCTURE_WINDOW_MS=3600000

RATE_LIMIT_DEVOPS_MONITORING_MAX_REQUESTS=100
RATE_LIMIT_DEVOPS_MONITORING_WINDOW_MS=3600000

RATE_LIMIT_DEVOPS_CONFIGURATION_MAX_REQUESTS=200
RATE_LIMIT_DEVOPS_CONFIGURATION_WINDOW_MS=3600000

# Speed Limiting
SPEED_LIMIT_DELAY_AFTER=100
SPEED_LIMIT_DELAY_MS=500
SPEED_LIMIT_MAX_DELAY_MS=20000

# =============================================================================
# TASK MANAGEMENT CONFIGURATION
# =============================================================================
TASK_QUEUE_MAX_SIZE=1000
TASK_TIMEOUT=300000
TASK_RETRY_ATTEMPTS=3
TASK_RETRY_DELAY=5000
TASK_CLEANUP_INTERVAL=3600000
TASK_MAX_CONCURRENT=10
TASK_RESULT_TTL=86400

# =============================================================================
# DEVOPS-SPECIFIC CONFIGURATION
# =============================================================================

# Supported Platforms
DEVOPS_SUPPORTED_PLATFORMS=kubernetes,docker,aws,azure,gcp,heroku,vercel
DEVOPS_SUPPORTED_PROVIDERS=aws,azure,gcp,terraform,pulumi
DEVOPS_SUPPORTED_MONITORING_TOOLS=prometheus,grafana,datadog,newrelic,splunk
DEVOPS_SUPPORTED_CONFIG_TOOLS=ansible,chef,puppet,terraform,helm

# Deployment Configuration
DEVOPS_DEPLOYMENT_TIMEOUT=1800000
DEVOPS_DEPLOYMENT_MAX_RETRIES=3
DEVOPS_DEPLOYMENT_HEALTH_CHECK_TIMEOUT=300000
DEVOPS_DEPLOYMENT_ROLLBACK_ENABLED=true

# Infrastructure Configuration
DEVOPS_INFRASTRUCTURE_TIMEOUT=3600000
DEVOPS_INFRASTRUCTURE_MAX_RETRIES=2
DEVOPS_INFRASTRUCTURE_VALIDATION_ENABLED=true
DEVOPS_INFRASTRUCTURE_DRY_RUN_ENABLED=true

# Monitoring Configuration
DEVOPS_MONITORING_TIMEOUT=600000
DEVOPS_MONITORING_MAX_RETRIES=3
DEVOPS_MONITORING_ALERT_ENABLED=true
DEVOPS_MONITORING_DASHBOARD_ENABLED=true

# Configuration Management
DEVOPS_CONFIG_TIMEOUT=900000
DEVOPS_CONFIG_MAX_RETRIES=3
DEVOPS_CONFIG_BACKUP_ENABLED=true
DEVOPS_CONFIG_VALIDATION_ENABLED=true

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
UPLOAD_MAX_FILE_SIZE=50mb
UPLOAD_MAX_FILES=10
UPLOAD_ALLOWED_TYPES=.yml,.yaml,.json,.tf,.hcl,.sh,.ps1,.dockerfile,.k8s
UPLOAD_DESTINATION=./tmp/uploads
UPLOAD_CLEANUP_INTERVAL=3600000

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
SECURITY_BCRYPT_ROUNDS=12
SECURITY_SESSION_SECRET=your_session_secret_here_minimum_32_characters
SECURITY_CSRF_ENABLED=true
SECURITY_HELMET_ENABLED=true
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_INPUT_VALIDATION_ENABLED=true
SECURITY_OUTPUT_SANITIZATION_ENABLED=true

# =============================================================================
# TELEMETRY CONFIGURATION
# =============================================================================

# OpenTelemetry
OTEL_SERVICE_NAME=devops-ai-agent
OTEL_SERVICE_VERSION=1.0.0
OTEL_ENVIRONMENT=development
OTEL_RESOURCE_ATTRIBUTES=service.name=devops-ai-agent,service.version=1.0.0

# Jaeger Tracing
JAEGER_ENDPOINT=http://localhost:14268/api/traces
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6832
JAEGER_SAMPLER_TYPE=const
JAEGER_SAMPLER_PARAM=1
JAEGER_ENABLED=true

# Prometheus Metrics
PROMETHEUS_PORT=9464
PROMETHEUS_ENDPOINT=/metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_DEFAULT_METRICS=true
PROMETHEUS_HISTOGRAM_BUCKETS=0.1,0.5,1,2,5,10

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_GRACE_PERIOD=60000

# =============================================================================
# ORCHESTRATOR INTEGRATION
# =============================================================================
ORCHESTRATOR_URL=http://localhost:3000
ORCHESTRATOR_API_KEY=orchestrator_api_key_here
ORCHESTRATOR_TIMEOUT=30000
ORCHESTRATOR_RETRY_ATTEMPTS=3
ORCHESTRATOR_RETRY_DELAY=2000
ORCHESTRATOR_HEALTH_CHECK_INTERVAL=60000

# =============================================================================
# SERVICE DISCOVERY CONFIGURATION
# =============================================================================
SERVICE_DISCOVERY_ENABLED=true
SERVICE_DISCOVERY_TYPE=consul
SERVICE_DISCOVERY_HOST=localhost
SERVICE_DISCOVERY_PORT=8500
SERVICE_DISCOVERY_SERVICE_NAME=devops-ai-agent
SERVICE_DISCOVERY_SERVICE_ID=devops-ai-agent-1
SERVICE_DISCOVERY_HEALTH_CHECK_URL=http://localhost:3003/health
SERVICE_DISCOVERY_TAGS=ai,devops,automation,microservice

# =============================================================================
# METADATA STORAGE CONFIGURATION
# =============================================================================
METADATA_STORAGE_TYPE=redis
METADATA_STORAGE_TTL=86400
METADATA_STORAGE_MAX_SIZE=1000
METADATA_STORAGE_CLEANUP_INTERVAL=3600000

# =============================================================================
# DEVELOPMENT/TESTING CONFIGURATION
# =============================================================================
DEV_MODE=true
DEV_MOCK_AI_RESPONSES=false
DEV_MOCK_EXTERNAL_SERVICES=false
DEV_ENABLE_DEBUG_ROUTES=true
DEV_ENABLE_METRICS_RESET=true

# Testing
TEST_TIMEOUT=30000
TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6380
TEST_REDIS_DATABASE=15

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
NODE_OPTIONS=--max-old-space-size=2048
UV_THREADPOOL_SIZE=16
NODE_MAX_HTTP_HEADER_SIZE=16384

# Clustering
CLUSTER_ENABLED=false
CLUSTER_WORKERS=auto

# =============================================================================
# MONITORING AND ALERTING
# =============================================================================
MONITORING_ENABLED=true
MONITORING_INTERVAL=60000
MONITORING_RETENTION_DAYS=30

# Alerting
ALERTING_ENABLED=true
ALERTING_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
ALERTING_EMAIL_ENABLED=false
ALERTING_EMAIL_SMTP_HOST=smtp.gmail.com
ALERTING_EMAIL_SMTP_PORT=587
ALERTING_EMAIL_USER=your-email@gmail.com
ALERTING_EMAIL_PASS=your-app-password

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_DEPLOYMENT_GENERATION=true
FEATURE_INFRASTRUCTURE_GENERATION=true
FEATURE_MONITORING_SETUP=true
FEATURE_CONFIGURATION_MANAGEMENT=true
FEATURE_TASK_QUEUE=true
FEATURE_CACHING=true
FEATURE_RATE_LIMITING=true
FEATURE_TELEMETRY=true
FEATURE_HEALTH_CHECKS=true
FEATURE_METRICS=true
FEATURE_API_DOCUMENTATION=true