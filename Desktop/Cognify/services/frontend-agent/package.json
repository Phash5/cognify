{
  "name": "@cognify/frontend-agent",
  "version": "1.0.0",
  "description": "Specialized AI Agent for Frontend Development Tasks",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "format": "prettier --write src/**/*.js",
    "format:check": "prettier --check src/**/*.js",
    "validate": "npm run lint && npm run test",
    "build": "echo 'No build step required for Node.js service'",
    "docker:build": "docker build -t frontend-agent .",
    "docker:run": "docker run -p 3001:3001 -p 9464:9464 frontend-agent",
    "health": "curl -f http://localhost:3001/health || exit 1",
    "metrics": "curl -f http://localhost:3001/metrics || exit 1"
  },
  "keywords": [
    "ai",
    "agent",
    "frontend",
    "react",
    "typescript",
    "ui",
    "microservice"
  ],
  "author": "Cognify Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "morgan": "^1.10.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "dotenv": "^16.3.1",
    "config": "^3.3.9",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "uuid": "^9.0.1",
    "axios": "^1.6.2",
    "redis": "^4.6.10",
    "ioredis": "^5.3.2",
    "openai": "^4.20.1",
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/sdk-node": "^0.45.1",
    "@opentelemetry/auto-instrumentations-node": "^0.40.3",
    "@opentelemetry/exporter-jaeger": "^1.17.2",
    "@opentelemetry/exporter-prometheus": "^0.45.1",
    "@opentelemetry/instrumentation-express": "^0.34.1",
    "@opentelemetry/instrumentation-http": "^0.45.1",
    "@opentelemetry/instrumentation-redis": "^0.35.2",
    "@opentelemetry/semantic-conventions": "^1.17.2",
    "prom-client": "^15.1.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "express-async-errors": "^3.1.1",
    "rate-limiter-flexible": "^3.0.8",
    "node-cache": "^5.1.2",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "validator": "^13.11.0",
    "sanitize-html": "^2.11.0",
    "xss": "^1.0.14",
    "fs-extra": "^11.1.1",
    "http-status-codes": "^2.3.0",
    "http-errors": "^2.0.0",
    "cookie-parser": "^1.4.6",
    "response-time": "^2.3.2",
    "@babel/parser": "^7.23.6",
    "@babel/traverse": "^7.23.6",
    "@babel/types": "^7.23.6",
    "@babel/generator": "^7.23.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jest": "^27.6.0",
    "eslint-plugin-security": "^1.7.1",
    "eslint-plugin-node": "^11.1.0",
    "prettier": "^3.1.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "cross-env": "^7.0.3",
    "concurrently": "^8.2.2",
    "@types/node": "^20.10.4",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/supertest": "^6.0.2",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/morgan": "^1.9.9",
    "@types/helmet": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^9.0.7",
    "@types/lodash": "^4.14.202",
    "@types/validator": "^13.11.7",
    "@types/cookie-parser": "^1.4.6",
    "@types/response-time": "^2.3.8",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cognify/frontend-agent.git"
  },
  "bugs": {
    "url": "https://github.com/cognify/frontend-agent/issues"
  },
  "homepage": "https://github.com/cognify/frontend-agent#readme",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!src/**/*.spec.js"
    ],
    "coverageDirectory": "coverage",
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ],
    "testTimeout": 30000
  },
  "eslintConfig": {
    "extends": [
      "airbnb-base",
      "plugin:jest/recommended",
      "plugin:security/recommended",
      "plugin:node/recommended"
    ],
    "plugins": ["jest", "security", "node"],
    "env": {
      "node": true,
      "jest": true,
      "es2022": true
    },
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    },
    "rules": {
      "no-console": "warn",
      "no-unused-vars": "error",
      "prefer-const": "error"
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}