# Frontend AI Agent Service Environment Configuration

# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
API_BASE_URL=http://localhost:3001

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
LOG_DATE_PATTERN=YYYY-MM-DD

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=frontend-agent:
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_RETRY_DELAY_ON_FAILURE=100
REDIS_MAX_RETRY_DELAY=2000

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000
CACHE_CHECK_PERIOD=600

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORGANIZATION=your-org-id
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.1
OPENAI_TIMEOUT=30000
OPENAI_MAX_RETRIES=3

# Authentication Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h
JWT_ISSUER=cognify-frontend-agent
JWT_AUDIENCE=cognify-users
API_KEY_HEADER=X-API-Key
AUTH_REQUIRED=true

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false
RATE_LIMIT_SKIP_FAILED_REQUESTS=false
RATE_LIMIT_STORE=redis

# AI Processing Rate Limits
AI_RATE_LIMIT_WINDOW_MS=3600000
AI_RATE_LIMIT_MAX_REQUESTS=50
AI_RATE_LIMIT_POINTS=10
AI_RATE_LIMIT_DURATION=3600

# Task Configuration
TASK_TIMEOUT=300000
TASK_MAX_RETRIES=3
TASK_RETRY_DELAY=5000
TASK_CLEANUP_INTERVAL=3600000
TASK_MAX_CONCURRENT=10
TASK_QUEUE_SIZE=100

# Code Generation Configuration
CODE_MAX_LENGTH=50000
CODE_TIMEOUT=60000
CODE_VALIDATION_ENABLED=true
CODE_SANITIZATION_ENABLED=true
CODE_ANALYSIS_ENABLED=true

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=.js,.ts,.jsx,.tsx,.css,.scss,.sass,.less,.html,.vue,.json,.md
UPLOAD_TEMP_DIR=./temp
UPLOAD_CLEANUP_INTERVAL=3600000

# Security Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true
HELMET_ENABLED=true
CSP_ENABLED=true
HSTS_ENABLED=true
XSS_PROTECTION_ENABLED=true

# Telemetry Configuration
TELEMETRY_ENABLED=true
TELEMETRY_SERVICE_NAME=frontend-agent
TELEMETRY_SERVICE_VERSION=1.0.0
TELEMETRY_ENVIRONMENT=development
TELEMETRY_SAMPLE_RATE=1.0

# Jaeger Configuration
JAEGER_ENDPOINT=http://localhost:14268/api/traces
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6832
JAEGER_SAMPLER_TYPE=const
JAEGER_SAMPLER_PARAM=1

# Prometheus Configuration
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9464
PROMETHEUS_ENDPOINT=/metrics
PROMETHEUS_PREFIX=frontend_agent_

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_GRACE_PERIOD=60000

# Orchestrator Configuration
ORCHESTRATE_URL=http://localhost:3000
ORCHESTRATE_API_KEY=your-orchestrator-api-key
ORCHESTRATE_TIMEOUT=10000
ORCHESTRATE_RETRY_ATTEMPTS=3
ORCHESTRATE_RETRY_DELAY=1000

# Service Discovery Configuration
SERVICE_DISCOVERY_ENABLED=false
SERVICE_DISCOVERY_URL=http://localhost:8500
SERVICE_DISCOVERY_TOKEN=
SERVICE_DISCOVERY_DATACENTER=dc1
SERVICE_DISCOVERY_HEALTH_CHECK_INTERVAL=10s

# Database Configuration (if needed)
DATABASE_URL=mongodb://localhost:27017/cognify-frontend-agent
DATABASE_MAX_POOL_SIZE=10
DATABASE_MIN_POOL_SIZE=2
DATABASE_CONNECT_TIMEOUT=10000
DATABASE_SOCKET_TIMEOUT=30000

# Development Configuration
DEBUG=frontend-agent:*
NODEMON_WATCH=src
NODEMON_EXT=js,json
NODEMON_IGNORE=node_modules,logs,temp,uploads

# Testing Configuration
TEST_TIMEOUT=30000
TEST_REDIS_URL=redis://localhost:6380
TEST_OPENAI_API_KEY=test-key
TEST_JWT_SECRET=test-secret

# Production Overrides (uncomment for production)
# NODE_ENV=production
# LOG_LEVEL=warn
# TELEMETRY_SAMPLE_RATE=0.1
# AUTH_REQUIRED=true
# RATE_LIMIT_MAX_REQUESTS=50
# AI_RATE_LIMIT_MAX_REQUESTS=20