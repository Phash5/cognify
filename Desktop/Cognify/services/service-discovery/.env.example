# Service Discovery Environment Configuration
# Copy this file to .env and configure for your environment

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server settings
NODE_ENV=development
PORT=3004
HOST=localhost

# CORS settings
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# Server timeouts (milliseconds)
SERVER_TIMEOUT=30000
KEEP_ALIVE_TIMEOUT=5000
HEADERS_TIMEOUT=60000
SHUTDOWN_TIMEOUT=10000

# =============================================================================
# SERVICE REGISTRY CONFIGURATION
# =============================================================================

# Registry settings
REGISTRY_DEFAULT_TTL=300
REGISTRY_HEARTBEAT_INTERVAL=30000
REGISTRY_HEALTH_CHECK_INTERVAL=60000
REGISTRY_CLEANUP_INTERVAL=120000
REGISTRY_MAX_RETRIES=3
REGISTRY_CACHE_ENABLED=true
REGISTRY_CACHE_TTL=60

# Load balancing
LOAD_BALANCING_STRATEGY=round_robin
LOAD_BALANCING_ENABLED=true

# Allowed services (comma-separated, empty = allow all)
ALLOWED_SERVICES=

# Default zone/region
DEFAULT_ZONE=us-east-1a
DEFAULT_REGION=us-east-1

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis settings
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=service-discovery:

# Redis connection settings
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_RETRY_DELAY=500
REDIS_MAX_RETRIES_PER_REQUEST=3
REDIS_LAZY_CONNECT=true
REDIS_KEEP_ALIVE=30000

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================

# Health check settings
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=60000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================

# General rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Service registration rate limiting
REGISTRATION_RATE_LIMIT_WINDOW_MS=60000
REGISTRATION_RATE_LIMIT_MAX=100

# Service discovery rate limiting
DISCOVERY_RATE_LIMIT_WINDOW_MS=60000
DISCOVERY_RATE_LIMIT_MAX=1000

# Heartbeat rate limiting
HEARTBEAT_RATE_LIMIT_WINDOW_MS=60000
HEARTBEAT_RATE_LIMIT_MAX=200

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# API Key authentication
API_KEY_ENABLED=false
API_KEYS=your-api-key-1,your-api-key-2

# JWT settings (if needed for future use)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_ISSUER=service-discovery
JWT_AUDIENCE=cognify-services

# Security headers
HELMET_ENABLED=true
CSP_ENABLED=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Logging settings
LOG_LEVEL=info
LOG_FORMAT=json

# Console logging
LOG_CONSOLE_ENABLED=true
LOG_CONSOLE_LEVEL=info

# File logging
LOG_FILE_ENABLED=true
LOG_FILE_LEVEL=info
LOG_FILE_FILENAME=service-discovery.log
LOG_FILE_MAX_SIZE=10485760
LOG_FILE_MAX_FILES=5

# =============================================================================
# TELEMETRY CONFIGURATION
# =============================================================================

# OpenTelemetry settings
TELEMETRY_ENABLED=false
TELEMETRY_SERVICE_NAME=service-discovery
TELEMETRY_SERVICE_NAMESPACE=cognify
TELEMETRY_SERVICE_VERSION=1.0.0

# Jaeger tracing
JAEGER_ENABLED=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6832

# Prometheus metrics
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
PROMETHEUS_ENDPOINT=/metrics

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Monitoring settings
MONITORING_ENABLED=true
METRICS_INTERVAL=60000

# Alerting thresholds
ALERT_HIGH_MEMORY_THRESHOLD=512
ALERT_HIGH_CPU_THRESHOLD=80
ALERT_HIGH_ERROR_RATE=0.05
ALERT_LOW_HEALTH_THRESHOLD=0.8

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Development features
DEVELOPMENT_ENABLED=true
DEBUG_ROUTES_ENABLED=true
MOCK_SERVICES_ENABLED=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Feature toggles
FEATURE_SERVICE_VERSIONING=true
FEATURE_CIRCUIT_BREAKER=false
FEATURE_LOAD_BALANCING=true
FEATURE_SERVICE_METADATA=true
FEATURE_EVENT_STREAMING=false
FEATURE_DISTRIBUTED_TRACING=false

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Performance settings
MAX_CONNECTIONS=1000
CONNECTION_TIMEOUT=30000
REQUEST_TIMEOUT=30000
RESPONSE_TIMEOUT=30000

# Memory settings
MAX_MEMORY_USAGE=512
GC_INTERVAL=300000

# Cache settings
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# =============================================================================
# CLUSTERING CONFIGURATION
# =============================================================================

# Cluster settings
CLUSTER_ENABLED=false
CLUSTER_WORKERS=0
CLUSTER_RESTART_DELAY=1000

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Service mesh integration
SERVICE_MESH_ENABLED=false
SERVICE_MESH_TYPE=istio

# Load balancer integration
EXTERNAL_LB_ENABLED=false
EXTERNAL_LB_TYPE=nginx

# =============================================================================
# BACKUP AND RECOVERY
# =============================================================================

# Backup settings
BACKUP_ENABLED=false
BACKUP_INTERVAL=3600000
BACKUP_RETENTION_DAYS=7
BACKUP_LOCATION=/app/backups

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================

# Test settings
TEST_TIMEOUT=30000
TEST_REDIS_DB=15
TEST_PORT=3005

# Mock settings
MOCK_SERVICES_COUNT=5
MOCK_HEALTH_CHECK_INTERVAL=10000

# =============================================================================
# ENVIRONMENT SPECIFIC OVERRIDES
# =============================================================================

# Production overrides
# NODE_ENV=production
# LOG_LEVEL=warn
# DEBUG_ROUTES_ENABLED=false
# MOCK_SERVICES_ENABLED=false
# REDIS_ENABLED=true
# TELEMETRY_ENABLED=true
# API_KEY_ENABLED=true

# Staging overrides
# NODE_ENV=staging
# LOG_LEVEL=info
# TELEMETRY_ENABLED=true
# REDIS_ENABLED=true

# Development overrides
# NODE_ENV=development
# LOG_LEVEL=debug
# DEBUG_ROUTES_ENABLED=true
# MOCK_SERVICES_ENABLED=true