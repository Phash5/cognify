{
  "name": "@cognify/communication",
  "version": "1.0.0",
  "description": "Shared communication library for Cognify microservices",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "validate": "npm run lint && npm run test",
    "build": "npm run validate",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "microservices",
    "communication",
    "http",
    "service-discovery",
    "circuit-breaker",
    "retry",
    "load-balancing",
    "event-bus",
    "message-queue",
    "observability",
    "tracing",
    "metrics",
    "logging",
    "caching",
    "validation",
    "security",
    "middleware",
    "cognify"
  ],
  "author": "Cognify Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "axios-retry": "^4.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "lodash": "^4.17.21",
    "eventemitter3": "^5.0.1",
    "p-retry": "^6.2.0",
    "p-timeout": "^6.1.2",
    "node-cache": "^5.1.2",
    "ioredis": "^5.3.2",
    "prom-client": "^15.0.0",
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/sdk-node": "^0.45.1",
    "@opentelemetry/instrumentation-http": "^0.45.1",
    "@opentelemetry/instrumentation-express": "^0.34.1",
    "@opentelemetry/exporter-jaeger": "^1.17.2",
    "@opentelemetry/exporter-prometheus": "^0.45.1",
    "@opentelemetry/exporter-zipkin": "^1.17.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "nodemon": "^3.0.2",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "@types/jest": "^29.5.8",
    "nock": "^13.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cognify/cognify.git",
    "directory": "shared/communication"
  },
  "bugs": {
    "url": "https://github.com/cognify/cognify/issues"
  },
  "homepage": "https://github.com/cognify/cognify#readme",
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!src/index.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2022": true,
      "jest": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-console": "warn",
      "no-unused-vars": "error",
      "prefer-const": "error",
      "no-var": "error"
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2
  }
}